[["la maison","f","房子；家","house; home","das Haus","Ma maison est près de la gare.","我家在火车站附近。","My house is near the station."],["l'appartement","m","公寓","flat; apartment","die Wohnung","L'appartement a deux chambres.","这套公寓有两间卧室。","The flat has two bedrooms."],["la famille","f","家庭","family","die Familie","Je passe le week-end en famille.","我和家人一起过周末。","I spend the weekend with my family."],["l'ami","m","朋友","friend","der Freund","C'est mon meilleur ami.","他是我最好的朋友。","He's my best friend."],["le travail","m","工作","work; job","die Arbeit","Je vais au travail en vélo.","我骑自行车上班。","I cycle to work."],["l'école","f","学校","school","die Schule","Les enfants sont à l'école.","孩子们在学校。","The children are at school."],["le pain","m","面包","bread","das Brot","J'achète du pain à la boulangerie.","我在面包店买面包。","I buy bread at the bakery."],["l'eau","f","水","water","das Wasser","Un verre d'eau, s'il vous plaît.","请来一杯水。","A glass of water, please."],["le café","m","咖啡；咖啡馆","coffee; café","der Kaffee; das Café","On prend un café ?","我们去喝杯咖啡？","Shall we have a coffee?"],["le train","m","火车","train","der Zug","Le train part à huit heures.","火车八点出发。","The train leaves at eight."],["la ville","f","城市","town; city","die Stadt","Lyon est une belle ville.","里昂是座美丽的城市。","Lyon is a beautiful city."],["la rue","f","街道","street","die Straße","J'habite dans une petite rue.","我住在一条小街上。","I live on a small street."],["le jour","m","天；白天","day","der Tag","Il pleut tous les jours.","每天都下雨。","It rains every day."],["la semaine","f","星期","week","die Woche","Je travaille cinq jours par semaine.","我一周工作五天。","I work five days a week."],["l'année","f","年","year","das Jahr","Bonne année !","新年快乐！","Happy New Year!"],["le temps","m","时间；天气","time; weather","die Zeit; das Wetter","Quel temps fait-il ?","天气怎么样？","What's the weather like?"],["le livre","m","书","book","das Buch","Je lis un livre sur Paris.","我在读一本关于巴黎的书。","I'm reading a book about Paris."],["la musique","f","音乐","music","die Musik","J'écoute de la musique le soir.","我晚上听音乐。","I listen to music in the evening."],["être","v","是；在","to be","sein","Je suis fatiguée aujourd'hui.","我今天很累。","I'm tired today."],["avoir","v","有","to have","haben","J'ai deux sœurs.","我有两个姐妹。","I have two sisters."],["aller","v","去","to go","gehen; fahren","On va au cinéma ce soir.","我们今晚去看电影。","We're going to the cinema tonight."],["faire","v","做","to do; to make","machen","Qu'est-ce que tu fais demain ?","你明天做什么？","What are you doing tomorrow?"],["vouloir","v","想要","to want","wollen","Je voudrais un thé.","我想要一杯茶。","I'd like a tea."],["pouvoir","v","能","can; to be able to","können","Tu peux m'aider ?","你能帮我吗？","Can you help me?"],["manger","v","吃","to eat","essen","On mange à midi.","我们中午吃饭。","We eat at noon."],["parler","v","说","to speak","sprechen","Vous parlez anglais ?","您会说英语吗？","Do you speak English?"],["habiter","v","居住","to live","wohnen","J'habite à Hanovre.","我住在汉诺威。","I live in Hanover."],["aimer","v","喜欢；爱","to like; to love","mögen; lieben","J'aime beaucoup le jazz.","我很喜欢爵士乐。","I really like jazz."],["grand","adj","大的","big; tall","groß","C'est une grande maison.","这是一栋大房子。","It's a big house."],["petit","adj","小的","small; little","klein","J'ai un petit chien.","我有一只小狗。","I have a little dog."],["bon","adj","好的","good","gut","Ce gâteau est très bon.","这个蛋糕很好吃。","This cake is very good."],["nouveau","adj","新的","new","neu","J'ai un nouveau travail.","我有一份新工作。","I have a new job."],["beau","adj","美的","beautiful; fine","schön","Il fait beau aujourd'hui.","今天天气很好。","The weather is nice today."],["aujourd'hui","adv","今天","today","heute","Aujourd'hui, je reste à la maison.","今天我待在家里。","Today I'm staying home."],["demain","adv","明天","tomorrow","morgen","À demain !","明天见！","See you tomorrow!"],["ici","adv","这里","here","hier","Viens ici, s'il te plaît.","请过来。","Come here, please."],["très","adv","非常","very","sehr","Merci, c'est très gentil.","谢谢，你真好。","Thanks, that's very kind."],["merci","interj","谢谢","thank you","danke","Merci beaucoup !","非常感谢！","Thank you very much!"],["s'il vous plaît","expr","请（敬语）","please (formal)","bitte","Un croissant, s'il vous plaît.","请给我一个可颂。","A croissant, please."],["bonjour","interj","你好；早上好","hello; good morning","guten Tag","Bonjour, madame !","女士，您好！","Hello, madam!"],["la mère","f","母亲","mother","die Mutter","Ma mère travaille dans une école.","我母亲在一所学校工作。","My mother works at a school."],["le père","m","父亲","father","der Vater","Mon père fait la cuisine le dimanche.","我父亲星期天做饭。","My father cooks on Sundays."],["le frère","m","兄弟","brother","der Bruder","J'ai un frère et deux sœurs.","我有一个兄弟和两个姐妹。","I have a brother and two sisters."],["la sœur","f","姐妹","sister","die Schwester","Ma sœur habite à Lyon.","我姐姐住在里昂。","My sister lives in Lyon."],["l'enfant","m","孩子","child","das Kind","L'enfant joue dans le jardin.","孩子在花园里玩。","The child is playing in the garden."],["le fils","m","儿子","son","der Sohn","Leur fils a six ans.","他们的儿子六岁。","Their son is six years old."],["la fille","f","女儿；女孩","daughter; girl","die Tochter; das Mädchen","Ma fille apprend le piano.","我女儿在学钢琴。","My daughter is learning the piano."],["les parents","pl","父母","parents","die Eltern","Mes parents viennent du Sénégal.","我父母来自塞内加尔。","My parents come from Senegal."],["le mari","m","丈夫","husband","der Ehemann","Son mari est infirmier.","她丈夫是护士。","Her husband is a nurse."],["la femme","f","女人；妻子","woman; wife","die Frau","Cette femme parle quatre langues.","这位女士会说四种语言。","This woman speaks four languages."],["l'homme","m","男人；人","man","der Mann","L'homme attend le bus.","那个男人在等公交车。","The man is waiting for the bus."],["le bébé","m","婴儿","baby","das Baby","Le bébé dort enfin.","宝宝终于睡着了。","The baby is finally asleep."],["la chambre","f","卧室","bedroom","das Schlafzimmer","Ma chambre est petite mais claire.","我的卧室很小但很明亮。","My bedroom is small but bright."],["la cuisine","f","厨房；烹饪","kitchen; cooking","die Küche","On mange dans la cuisine.","我们在厨房吃饭。","We eat in the kitchen."],["la salle de bains","f","浴室","bathroom","das Badezimmer","La salle de bains est à gauche.","浴室在左边。","The bathroom is on the left."],["la table","f","桌子","table","der Tisch","Les clés sont sur la table.","钥匙在桌子上。","The keys are on the table."],["la chaise","f","椅子","chair","der Stuhl","Prends une chaise, s'il te plaît.","请拿一把椅子。","Take a chair, please."],["le lit","m","床","bed","das Bett","Je lis au lit le soir.","我晚上在床上看书。","I read in bed in the evening."],["la porte","f","门","door","die Tür","Tu peux fermer la porte ?","你能关上门吗？","Can you close the door?"],["la fenêtre","f","窗户","window","das Fenster","J'ouvre la fenêtre le matin.","我早上开窗。","I open the window in the morning."],["la clé","f","钥匙","key","der Schlüssel","J'ai perdu la clé de la voiture.","我把车钥匙弄丢了。","I've lost the car key."],["le thé","m","茶","tea","der Tee","Je bois du thé vert le matin.","我早上喝绿茶。","I drink green tea in the morning."],["la tasse","f","杯子（带把）","cup","die Tasse","Une tasse de thé, s'il vous plaît.","请来一杯茶。","A cup of tea, please."],["le lait","m","牛奶","milk","die Milch","Il n'y a plus de lait.","牛奶没有了。","There's no more milk."],["le fromage","m","奶酪","cheese","der Käse","En France, on mange beaucoup de fromage.","在法国，人们吃很多奶酪。","In France, people eat a lot of cheese."],["la pomme","f","苹果","apple","der Apfel","Je mange une pomme à dix heures.","我十点吃一个苹果。","I eat an apple at ten o'clock."],["le riz","m","米饭；大米","rice","der Reis","Le riz est prêt dans dix minutes.","米饭十分钟后好。","The rice will be ready in ten minutes."],["la viande","f","肉","meat","das Fleisch","Elle ne mange pas de viande.","她不吃肉。","She doesn't eat meat."],["le poisson","m","鱼","fish","der Fisch","Ce soir, on mange du poisson.","今晚我们吃鱼。","Tonight we're having fish."],["les légumes","m","蔬菜","vegetables","das Gemüse","J'achète des légumes au marché.","我在集市买蔬菜。","I buy vegetables at the market."],["le fruit","m","水果","fruit","das Obst; die Frucht","La mangue est mon fruit préféré.","芒果是我最喜欢的水果。","Mango is my favourite fruit."],["le sucre","m","糖","sugar","der Zucker","Tu prends du sucre dans ton café ?","你咖啡里加糖吗？","Do you take sugar in your coffee?"],["le sel","m","盐","salt","das Salz","Tu peux me passer le sel ?","你能把盐递给我吗？","Can you pass me the salt?"],["le petit-déjeuner","m","早餐","breakfast","das Frühstück","Le petit-déjeuner est à huit heures.","早餐八点开始。","Breakfast is at eight o'clock."],["le déjeuner","m","午餐","lunch","das Mittagessen","On se voit pour le déjeuner ?","我们午饭时见？","Shall we meet for lunch?"],["le dîner","m","晚餐","dinner","das Abendessen","Le dîner est prêt, venez à table !","晚饭好了，来吃饭吧！","Dinner's ready, come to the table!"],["le restaurant","m","餐馆","restaurant","das Restaurant","Ce restaurant vietnamien est excellent.","这家越南餐馆非常好。","This Vietnamese restaurant is excellent."],["le marché","m","集市；市场","market","der Markt","Le marché a lieu le samedi.","集市在星期六。","The market is on Saturdays."],["la boulangerie","f","面包店","bakery","die Bäckerei","Je vais à la boulangerie acheter du pain.","我去面包店买面包。","I'm going to the bakery to buy bread."],["le bus","m","公交车","bus","der Bus","Je prends le bus pour aller au travail.","我坐公交车去上班。","I take the bus to work."],["le métro","m","地铁","underground; metro","die U-Bahn","Le métro est rapide à Paris.","巴黎的地铁很快。","The metro is fast in Paris."],["la gare","f","火车站","railway station","der Bahnhof","La gare est à dix minutes.","火车站在十分钟路程外。","The station is ten minutes away."],["la voiture","f","汽车","car","das Auto","Nous n'avons pas de voiture.","我们没有车。","We don't have a car."],["le vélo","m","自行车","bike","das Fahrrad","Je vais à l'école à vélo.","我骑自行车去学校。","I go to school by bike."],["l'avion","m","飞机","plane","das Flugzeug","L'avion part à midi.","飞机中午起飞。","The plane leaves at noon."],["le musée","m","博物馆","museum","das Museum","Le musée est gratuit le dimanche.","博物馆星期天免费。","The museum is free on Sundays."],["le cinéma","m","电影院","cinema","das Kino","On va au cinéma ce soir ?","我们今晚去看电影吗？","Shall we go to the cinema tonight?"],["la banque","f","银行","bank","die Bank","La banque ferme à dix-sept heures.","银行下午五点关门。","The bank closes at 5 p.m."],["la poste","f","邮局","post office","die Post","Je vais à la poste envoyer un colis.","我去邮局寄一个包裹。","I'm going to the post office to send a parcel."],["l'hôpital","m","医院","hospital","das Krankenhaus","Ma tante travaille à l'hôpital.","我阿姨在医院工作。","My aunt works at the hospital."],["le matin","m","早上","morning","der Morgen","Je cours tous les matins.","我每天早上跑步。","I run every morning."],["le soir","m","晚上","evening","der Abend","Le soir, j'écoute de la musique.","晚上我听音乐。","In the evening I listen to music."],["la nuit","f","夜晚","night","die Nacht","Bonne nuit, à demain !","晚安，明天见！","Good night, see you tomorrow!"],["l'heure","f","小时；钟点","hour; time (o'clock)","die Stunde; die Uhrzeit","Quelle heure est-il ?","现在几点了？","What time is it?"],["la minute","f","分钟","minute","die Minute","Attends une minute, j'arrive.","等一分钟，我马上来。","Wait a minute, I'm coming."],["lundi","m","星期一","Monday","der Montag","Le cours de français commence lundi.","法语课星期一开始。","The French class starts on Monday."],["mardi","m","星期二","Tuesday","der Dienstag","Le mardi, je fais du sport.","我每周二运动。","On Tuesdays I do sport."],["mercredi","m","星期三","Wednesday","der Mittwoch","Mercredi, les enfants n'ont pas école.","星期三孩子们不上学。","On Wednesday the children have no school."],["jeudi","m","星期四","Thursday","der Donnerstag","On se voit jeudi soir ?","我们星期四晚上见？","Shall we meet on Thursday evening?"],["vendredi","m","星期五","Friday","der Freitag","Vendredi, je travaille à la maison.","星期五我在家工作。","On Friday I work from home."],["samedi","m","星期六","Saturday","der Samstag","Samedi, nous allons au marché.","星期六我们去集市。","On Saturday we go to the market."],["dimanche","m","星期日","Sunday","der Sonntag","Le dimanche, les magasins sont fermés.","星期天商店都关门。","On Sundays the shops are closed."],["le mois","m","月","month","der Monat","Je pars au Brésil le mois prochain.","我下个月去巴西。","I'm going to Brazil next month."],["le week-end","m","周末","weekend","das Wochenende","Bon week-end, à lundi !","周末愉快，星期一见！","Have a nice weekend, see you Monday!"],["un","num","一","one","eins","J'ai un chat et un chien.","我有一只猫和一条狗。","I have a cat and a dog."],["deux","num","二","two","zwei","Deux cafés, s'il vous plaît.","请来两杯咖啡。","Two coffees, please."],["trois","num","三","three","drei","Ils ont trois enfants.","他们有三个孩子。","They have three children."],["quatre","num","四","four","vier","Nous sommes quatre à table.","我们一桌四个人。","There are four of us at the table."],["cinq","num","五","five","fünf","Le bus arrive dans cinq minutes.","公交车五分钟后到。","The bus arrives in five minutes."],["six","num","六","six","sechs","Je me lève à six heures.","我六点起床。","I get up at six o'clock."],["sept","num","七","seven","sieben","Il y a sept jours dans une semaine.","一周有七天。","There are seven days in a week."],["huit","num","八","eight","acht","Le magasin ouvre à huit heures.","商店八点开门。","The shop opens at eight o'clock."],["neuf","num","九","nine","neun","Ma fille a neuf ans.","我女儿九岁。","My daughter is nine years old."],["dix","num","十","ten","zehn","Ça coûte dix euros.","这个十欧元。","That costs ten euros."],["vingt","num","二十","twenty","zwanzig","J'ai vingt ans aujourd'hui !","我今天二十岁了！","I'm twenty today!"],["cent","num","一百","hundred","hundert","Le billet coûte cent euros.","票价一百欧元。","The ticket costs a hundred euros."],["mille","num","一千","thousand","tausend","Paris est à mille kilomètres d'ici.","巴黎离这里一千公里。","Paris is a thousand kilometres from here."],["rouge","adj","红色的","red","rot","Elle porte une robe rouge.","她穿着一条红裙子。","She's wearing a red dress."],["bleu","adj","蓝色的","blue","blau","Le ciel est bleu aujourd'hui.","今天天空是蓝的。","The sky is blue today."],["vert","adj","绿色的","green","grün","J'aime le thé vert.","我喜欢绿茶。","I like green tea."],["jaune","adj","黄色的","yellow","gelb","Le taxi est jaune.","出租车是黄色的。","The taxi is yellow."],["noir","adj","黑色的","black","schwarz","Je voudrais un café noir.","我想要一杯黑咖啡。","I'd like a black coffee."],["blanc","adj","白色的","white","weiß","Les murs sont blancs.","墙是白色的。","The walls are white."],["la couleur","f","颜色","colour","die Farbe","Quelle est ta couleur préférée ?","你最喜欢什么颜色？","What's your favourite colour?"],["la tête","f","头","head","der Kopf","J'ai mal à la tête.","我头疼。","I have a headache."],["la main","f","手","hand","die Hand","Lave-toi les mains avant de manger.","吃饭前洗手。","Wash your hands before eating."],["les yeux","m","眼睛（复数）","eyes","die Augen","Elle a les yeux marron.","她的眼睛是棕色的。","She has brown eyes."],["le ventre","m","肚子","stomach; belly","der Bauch","J'ai mal au ventre.","我肚子疼。","I have a stomach ache."],["le pied","m","脚","foot","der Fuß","On y va à pied ?","我们走路去吗？","Shall we go on foot?"],["les cheveux","m","头发","hair","die Haare","Il a les cheveux courts.","他留着短发。","He has short hair."],["le pantalon","m","裤子","trousers","die Hose","Ce pantalon est trop long.","这条裤子太长了。","These trousers are too long."],["la chemise","f","衬衫","shirt","das Hemd","Il porte une chemise blanche.","他穿着一件白衬衫。","He's wearing a white shirt."],["la robe","f","连衣裙","dress","das Kleid","Cette robe est très jolie.","这条连衣裙很漂亮。","This dress is very pretty."],["les chaussures","f","鞋子","shoes","die Schuhe","Enlève tes chaussures, s'il te plaît.","请把鞋脱了。","Take your shoes off, please."],["le manteau","m","大衣","coat","der Mantel","Prends ton manteau, il fait froid.","带上大衣，天冷。","Take your coat, it's cold."],["le pull","m","毛衣","jumper; sweater","der Pullover","J'ai acheté un pull en laine.","我买了一件羊毛衫。","I bought a wool jumper."],["le sac","m","包","bag","die Tasche","Mon téléphone est dans mon sac.","我的手机在包里。","My phone is in my bag."],["la radio","f","收音机；广播","radio","das Radio","J'écoute la radio dans la voiture.","我在车里听广播。","I listen to the radio in the car."],["la guitare","f","吉他","guitar","die Gitarre","Mon frère joue de la guitare.","我哥哥弹吉他。","My brother plays the guitar."],["le piano","m","钢琴","piano","das Klavier","Elle joue du piano depuis l'enfance.","她从小弹钢琴。","She has played the piano since childhood."],["prendre","v","拿；乘坐；吃喝","to take; to have (food)","nehmen","Je prends le train à huit heures.","我八点坐火车。","I take the train at eight o'clock."],["venir","v","来","to come","kommen","Tu viens avec nous ce soir ?","你今晚和我们一起来吗？","Are you coming with us tonight?"],["dire","v","说","to say; to tell","sagen","Comment on dit « merci » en chinois ?","中文“merci”怎么说？","How do you say \"thank you\" in Chinese?"],["voir","v","看见","to see","sehen","Je vois mes amis le samedi.","我星期六见朋友。","I see my friends on Saturdays."],["savoir","v","知道；会","to know; can","wissen; können","Tu sais nager ?","你会游泳吗？","Can you swim?"],["boire","v","喝","to drink","trinken","Il faut boire beaucoup d'eau.","要多喝水。","You should drink a lot of water."],["dormir","v","睡觉","to sleep","schlafen","Je dors huit heures par nuit.","我每晚睡八个小时。","I sleep eight hours a night."],["lire","v","读","to read","lesen","Elle lit un roman japonais.","她在读一本日本小说。","She's reading a Japanese novel."],["écrire","v","写","to write","schreiben","J'écris un message à ma mère.","我在给妈妈写信息。","I'm writing a message to my mother."],["écouter","v","听","to listen (to)","zuhören; hören","J'écoute du jazz en travaillant.","我边工作边听爵士乐。","I listen to jazz while working."],["regarder","v","看","to watch; to look at","ansehen; schauen","On regarde un film ce soir ?","我们今晚看部电影？","Shall we watch a film tonight?"],["travailler","v","工作","to work","arbeiten","Je travaille dans un hôpital.","我在一家医院工作。","I work in a hospital."],["étudier","v","学习","to study","studieren; lernen","Elle étudie l'informatique à Lille.","她在里尔学计算机。","She studies computer science in Lille."],["apprendre","v","学习；学会","to learn","lernen","J'apprends le français depuis un an.","我学法语一年了。","I've been learning French for a year."],["comprendre","v","理解；明白","to understand","verstehen","Je ne comprends pas cette phrase.","我不懂这句话。","I don't understand this sentence."],["acheter","v","买","to buy","kaufen","J'achète du pain tous les jours.","我每天买面包。","I buy bread every day."],["se lever","v","起床","to get up","aufstehen","Je me lève tôt en semaine.","工作日我起得早。","I get up early during the week."],["s'appeler","v","名叫","to be called","heißen","Comment tu t'appelles ?","你叫什么名字？","What's your name?"],["se coucher","v","上床睡觉","to go to bed","ins Bett gehen","Les enfants se couchent à vingt heures.","孩子们晚上八点睡觉。","The children go to bed at 8 p.m."],["ouvrir","v","打开","to open","öffnen","Le magasin ouvre à neuf heures.","商店九点开门。","The shop opens at nine o'clock."],["fermer","v","关上","to close","schließen","N'oublie pas de fermer la porte.","别忘了关门。","Don't forget to close the door."],["jouer","v","玩；演奏","to play","spielen","Les enfants jouent au foot dans la cour.","孩子们在院子里踢足球。","The children play football in the yard."],["danser","v","跳舞","to dance","tanzen","On danse la samba au Brésil.","在巴西人们跳桑巴。","People dance samba in Brazil."],["cuisiner","v","做饭","to cook","kochen","Mon mari aime cuisiner des plats indiens.","我丈夫喜欢做印度菜。","My husband likes cooking Indian dishes."],["jeune","adj","年轻的","young","jung","Ma voisine est très jeune.","我的邻居很年轻。","My neighbour is very young."],["vieux","adj","老的；旧的","old","alt","C'est un vieux quartier de la ville.","这是城里的一个老街区。","It's an old part of town."],["chaud","adj","热的","hot; warm","warm; heiß","Attention, le thé est très chaud.","小心，茶很烫。","Careful, the tea is very hot."],["froid","adj","冷的","cold","kalt","L'eau de la mer est froide.","海水很冷。","The sea water is cold."],["gentil","adj","友善的；亲切的","kind; nice","nett","Tes parents sont très gentils.","你父母人很好。","Your parents are very kind."],["heureux","adj","幸福的；高兴的","happy","glücklich","Je suis heureux de te voir.","见到你我很高兴。","I'm happy to see you."],["rapide","adj","快的","fast; quick","schnell","Le TGV est très rapide.","高速列车非常快。","The TGV is very fast."],["joli","adj","漂亮的","pretty","hübsch","Quelle jolie chanson !","多好听的歌！","What a pretty song!"],["maintenant","adv","现在","now","jetzt","Je dois partir maintenant.","我现在得走了。","I have to leave now."],["hier","adv","昨天","yesterday","gestern","Hier, il a plu toute la journée.","昨天下了一整天雨。","Yesterday it rained all day."],["souvent","adv","经常","often","oft","Je vais souvent à la bibliothèque.","我经常去图书馆。","I often go to the library."],["beaucoup","adv","很多；非常","a lot; very much","viel; sehr","Merci beaucoup pour ton aide.","非常感谢你的帮助。","Thank you very much for your help."],["un peu","adv","一点","a little","ein bisschen","Je parle un peu français.","我会说一点法语。","I speak a little French."],["aussi","adv","也","also; too","auch","Moi aussi, j'aime le thé.","我也喜欢茶。","I like tea too."],["et","conj","和；并且","and","und","Ma sœur et moi parlons arabe.","我和姐姐说阿拉伯语。","My sister and I speak Arabic."],["mais","conj","但是","but","aber","C'est cher, mais c'est bon.","贵，但好吃。","It's expensive, but it's good."],["ou","conj","或者","or","oder","Thé ou café ?","茶还是咖啡？","Tea or coffee?"],["avec","prep","和……一起；用","with","mit","Je vis avec ma famille.","我和家人住在一起。","I live with my family."],["sans","prep","没有","without","ohne","Un café sans sucre, s'il vous plaît.","请来一杯不加糖的咖啡。","A coffee without sugar, please."],["pour","prep","为了；给","for; to","für; um … zu","Ce cadeau est pour toi.","这份礼物是给你的。","This present is for you."],["dans","prep","在……里","in","in","Le chat dort dans la cuisine.","猫在厨房里睡觉。","The cat is sleeping in the kitchen."],["sur","prep","在……上","on","auf","Ton livre est sur la chaise.","你的书在椅子上。","Your book is on the chair."],["sous","prep","在……下","under","unter","Le chien est sous la table.","狗在桌子底下。","The dog is under the table."],["où","adv","哪里","where","wo","Où est la gare ?","火车站在哪里？","Where is the station?"],["quand","adv","什么时候；当……时","when","wann; wenn","Quand est-ce que tu pars ?","你什么时候走？","When are you leaving?"],["comment","adv","怎样","how","wie","Comment ça va ?","你好吗？","How are you?"]]