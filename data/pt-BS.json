[["oi","interj","嗨；你好（随意）","hi","salut","Oi, tudo bem?","嗨，你好吗？","Hi, how are you?"],["olá","interj","你好","hello","bonjour","Olá! Meu nome é Ana.","你好！我叫安娜。","Hello! My name is Ana."],["bom dia","expr","早上好","good morning","bonjour","Bom dia! Você quer café?","早上好！你要咖啡吗？","Good morning! Do you want coffee?"],["boa tarde","expr","下午好","good afternoon","bon après-midi","Boa tarde, Dona Rosa!","下午好，罗莎太太！","Good afternoon, Dona Rosa!"],["boa noite","expr","晚上好；晚安","good evening; good night","bonsoir; bonne nuit","Boa noite, até amanhã!","晚安，明天见！","Good night, see you tomorrow!"],["tudo bem?","expr","你好吗？（一切都好吗）","how are you? (all good?)","ça va ?","Oi, Pedro! Tudo bem?","嗨，佩德罗！你好吗？","Hi, Pedro! All good?"],["tudo bem","expr","都好；挺好的","all good; I'm fine","ça va","Tudo bem, obrigada. E você?","挺好的，谢谢。你呢？","I'm fine, thanks. And you?"],["tudo bom?","expr","都好吗？","everything good?","tout va bien ?","Tudo bom? Faz tempo!","都好吗？好久不见！","Everything good? It's been a while!"],["e você?","expr","你呢？","and you?","et toi ?","Estou bem. E você?","我很好。你呢？","I'm well. And you?"],["como vai?","expr","你好吗？（稍正式）","how are you doing?","comment allez-vous ?","Bom dia, senhor. Como vai?","先生早上好。您好吗？","Good morning, sir. How are you doing?"],["muito prazer","expr","很高兴认识你","nice to meet you","enchanté","Muito prazer, eu sou a Ana.","很高兴认识你，我是安娜。","Nice to meet you, I'm Ana."],["qual é o seu nome?","expr","你叫什么名字？","what's your name?","comment tu t'appelles ?","Oi! Qual é o seu nome?","嗨！你叫什么名字？","Hi! What's your name?"],["meu nome é…","expr","我的名字是……","my name is…","je m'appelle…","Meu nome é Fang. E o seu?","我叫芳。你呢？","My name is Fang. And yours?"],["de onde você é?","expr","你是哪里人？","where are you from?","d'où viens-tu ?","De onde você é? — Sou da China.","你是哪里人？——我是中国人。","Where are you from? — I'm from China."],["eu sou de…","expr","我来自……","I'm from…","je viens de…","Eu sou de Hangzhou, mas moro na Alemanha.","我来自杭州，但住在德国。","I'm from Hangzhou, but I live in Germany."],["tchau","interj","再见；拜拜","bye","salut ; au revoir","Tchau, até logo!","拜拜，回头见！","Bye, see you later!"],["até logo","expr","回头见","see you later","à plus tard","Até logo, gente!","大家回头见！","See you later, everyone!"],["até amanhã","expr","明天见","see you tomorrow","à demain","Até amanhã às oito!","明天八点见！","See you tomorrow at eight!"],["até mais","expr","再见；回见","see you","à plus","Valeu, até mais!","谢啦，回见！","Thanks, see you!"],["obrigado / obrigada","expr","谢谢（男说 obrigado，女说 obrigada）","thank you (men: obrigado, women: obrigada)","merci","Obrigada pelo café!","谢谢你的咖啡！","Thanks for the coffee!"],["de nada","expr","不客气","you're welcome","de rien","Obrigado! — De nada.","谢谢！——不客气。","Thank you! — You're welcome."],["por favor","expr","请","please","s'il te plaît","Um pão de queijo, por favor.","请给我一个奶酪面包。","A cheese bread, please."],["com licença","expr","劳驾；借过","excuse me (to pass / ask)","excusez-moi ; pardon","Com licença, onde fica o banheiro?","劳驾，洗手间在哪儿？","Excuse me, where is the bathroom?"],["desculpa","expr","对不起","sorry","pardon ; désolé","Desculpa, estou atrasada.","对不起，我迟到了。","Sorry, I'm late."],["valeu","interj","谢啦（口语）","thanks (casual)","merci (familier)","Valeu pela ajuda!","谢谢帮忙！","Thanks for the help!"],["beleza?","expr","还好吧？（口语）","all good? (casual)","ça roule ?","E aí, beleza? — Beleza!","怎么样，还好吧？——挺好！","Hey, all good? — All good!"],["o ano","m","年","year","l'année","O ano tem doze meses.","一年有十二个月。","A year has twelve months."],["o mês","m","月","month","le mois","Este mês é outubro.","这个月是十月。","This month is October."],["a semana","f","星期；周","week","la semaine","A semana tem sete dias.","一周有七天。","A week has seven days."],["o dia","m","天；日","day","le jour","Hoje é um dia bonito.","今天是美好的一天。","Today is a beautiful day."],["a data","f","日期","date","la date","Qual é a data de hoje?","今天是几号？","What's today's date?"],["que dia é hoje?","expr","今天星期几？/ 今天几号？","what day is it today?","quel jour sommes-nous ?","Que dia é hoje? — Hoje é quarta-feira.","今天星期几？——今天星期三。","What day is it today? — Today is Wednesday."],["hoje","adv","今天","today","aujourd'hui","Hoje está calor.","今天很热。","It's hot today."],["amanhã","adv","明天","tomorrow","demain","Amanhã eu trabalho.","明天我上班。","Tomorrow I work."],["ontem","adv","昨天","yesterday","hier","Ontem choveu muito.","昨天雨下得很大。","Yesterday it rained a lot."],["que horas são?","expr","几点了？","what time is it?","quelle heure est-il ?","Que horas são? — São três horas.","几点了？——三点。","What time is it? — It's three o'clock."],["é uma hora","expr","一点钟","it's one o'clock","il est une heure","É uma hora. Vamos almoçar?","一点了。去吃午饭吗？","It's one o'clock. Shall we have lunch?"],["são duas horas","expr","两点钟（两点以上用 são）","it's two o'clock","il est deux heures","São duas horas da tarde.","下午两点。","It's two in the afternoon."],["e meia","expr","……点半","half past","et demie","A aula começa às sete e meia.","课七点半开始。","The class starts at half past seven."],["o meio-dia","m","中午十二点","noon","midi","Almoço ao meio-dia.","我中午十二点吃午饭。","I have lunch at noon."],["a meia-noite","f","午夜十二点","midnight","minuit","A festa termina à meia-noite.","派对午夜结束。","The party ends at midnight."],["de manhã","expr","早上；上午","in the morning","le matin","De manhã eu tomo café.","我早上喝咖啡。","In the morning I drink coffee."],["à tarde","expr","下午","in the afternoon","l'après-midi","À tarde eu estudo português.","我下午学葡语。","In the afternoon I study Portuguese."],["à noite","expr","晚上","in the evening; at night","le soir","À noite eu leio um livro.","我晚上看书。","In the evening I read a book."],["o fim de semana","m","周末","weekend","le week-end","No fim de semana eu descanso.","周末我休息。","At the weekend I rest."],["o aniversário","m","生日","birthday","l'anniversaire","Meu aniversário é em 30 de maio.","我的生日是五月三十日。","My birthday is on 30 May."],["segunda-feira","f","星期一","Monday","lundi","Na segunda-feira eu começo o trabalho cedo.","星期一我很早开始工作。","On Monday I start work early."],["terça-feira","f","星期二","Tuesday","mardi","Na terça-feira tenho aula de português.","星期二我有葡语课。","On Tuesday I have Portuguese class."],["quarta-feira","f","星期三","Wednesday","mercredi","Hoje é quarta-feira, o meio da semana.","今天星期三，一周的中间。","Today is Wednesday, the middle of the week."],["quinta-feira","f","星期四","Thursday","jeudi","Na quinta-feira eu vou ao mercado.","星期四我去市场。","On Thursday I go to the market."],["sexta-feira","f","星期五","Friday","vendredi","Sexta-feira à noite a gente sai com amigos.","星期五晚上我们和朋友出去。","On Friday evening we go out with friends."],["sábado","m","星期六","Saturday","samedi","No sábado eu durmo até tarde.","星期六我睡到很晚。","On Saturday I sleep late."],["domingo","m","星期日","Sunday","dimanche","No domingo a família almoça junto.","星期日全家一起吃午饭。","On Sunday the family has lunch together."],["janeiro","m","一月","January","janvier","Em janeiro faz muito calor no Brasil.","巴西一月很热。","In January it's very hot in Brazil."],["fevereiro","m","二月","February","février","O Carnaval é em fevereiro ou março.","狂欢节在二月或三月。","Carnival is in February or March."],["março","m","三月","March","mars","Em março começam as aulas.","三月开学。","Classes start in March."],["abril","m","四月","April","avril","Meu irmão faz aniversário em abril.","我哥哥的生日在四月。","My brother's birthday is in April."],["maio","m","五月","May","mai","Meu aniversário é em maio.","我的生日在五月。","My birthday is in May."],["junho","m","六月","June","juin","Em junho tem festa junina.","六月有六月节。","In June there are festas juninas."],["julho","m","七月","July","juillet","Em julho é inverno no Brasil.","巴西七月是冬天。","In July it's winter in Brazil."],["agosto","m","八月","August","août","Em agosto eu viajo para a China.","八月我去中国旅行。","In August I travel to China."],["setembro","m","九月","September","septembre","Em setembro começa a primavera no Brasil.","巴西九月开始是春天。","In September spring starts in Brazil."],["outubro","m","十月","October","octobre","Hoje é dia 28 de outubro.","今天是十月二十八日。","Today is 28 October."],["novembro","m","十一月","November","novembre","Em novembro chove muito aqui.","这里十一月雨很多。","In November it rains a lot here."]