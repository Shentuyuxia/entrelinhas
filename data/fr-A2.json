[["le voyage","m","旅行","trip; journey","die Reise","Le voyage en train a duré six heures.","坐火车旅行花了六个小时。","The train journey took six hours."],["le billet","m","票","ticket","die Fahrkarte; die Eintrittskarte","J'ai acheté deux billets pour le concert.","我买了两张音乐会的票。","I bought two tickets for the concert."],["la valise","f","行李箱","suitcase","der Koffer","Ma valise est trop lourde.","我的行李箱太重了。","My suitcase is too heavy."],["l'aéroport","m","机场","airport","der Flughafen","Je t'attends à l'aéroport.","我在机场等你。","I'll wait for you at the airport."],["le rendez-vous","m","约会；预约","appointment; meeting","der Termin; die Verabredung","J'ai rendez-vous chez le médecin.","我约了医生。","I have a doctor's appointment."],["le médecin","m","医生","doctor","der Arzt","Il faut appeler le médecin.","得叫医生。","We need to call the doctor."],["la pharmacie","f","药店","pharmacy","die Apotheke","La pharmacie ferme à dix-neuf heures.","药店晚上七点关门。","The pharmacy closes at 7 p.m."],["le loyer","m","房租","rent","die Miete","Le loyer est cher à Paris.","巴黎的房租很贵。","Rent is expensive in Paris."],["le voisin","m","邻居","neighbour","der Nachbar","Mon voisin joue du piano.","我的邻居弹钢琴。","My neighbour plays the piano."],["la chanson","f","歌曲","song","das Lied","C'est ma chanson préférée.","这是我最喜欢的歌。","It's my favourite song."],["le concert","m","音乐会","concert","das Konzert","Le concert commence à vingt heures.","音乐会晚上八点开始。","The concert starts at 8 p.m."],["le film","m","电影","film","der Film","On regarde un film ce soir ?","我们今晚看电影吗？","Shall we watch a film tonight?"],["le cadeau","m","礼物","present; gift","das Geschenk","Merci pour le cadeau !","谢谢你的礼物！","Thanks for the present!"],["les vacances","f","假期","holidays","die Ferien; der Urlaub","On part en vacances en août.","我们八月去度假。","We're going on holiday in August."],["la météo","f","天气预报","weather forecast","der Wetterbericht","La météo annonce de la pluie.","天气预报说有雨。","The forecast says rain."],["attendre","v","等","to wait (for)","warten","J'attends le bus depuis vingt minutes.","我等公交等了二十分钟。","I've been waiting for the bus for twenty minutes."],["arriver","v","到达","to arrive","ankommen","Le train arrive en retard.","火车晚点到达。","The train is arriving late."],["partir","v","离开；出发","to leave","abfahren; weggehen","Nous partons demain matin.","我们明天早上出发。","We're leaving tomorrow morning."],["payer","v","付钱","to pay","bezahlen","Je peux payer par carte ?","我可以刷卡吗？","Can I pay by card?"],["chercher","v","找","to look for","suchen","Je cherche la gare.","我在找火车站。","I'm looking for the station."],["trouver","v","找到；认为","to find","finden","Je ne trouve pas mes clés.","我找不到钥匙了。","I can't find my keys."],["oublier","v","忘记","to forget","vergessen","J'ai oublié mon parapluie.","我忘了带伞。","I forgot my umbrella."],["se souvenir de","v","记得","to remember","sich erinnern an","Tu te souviens de son nom ?","你记得他的名字吗？","Do you remember his name?"],["inviter","v","邀请","to invite","einladen","Elle m'a invitée à dîner.","她请我吃晚饭。","She invited me to dinner."],["commencer","v","开始","to start","anfangen","Le cours commence à neuf heures.","课九点开始。","The class starts at nine."],["finir","v","结束；完成","to finish","beenden","Je finis le travail à dix-sept heures.","我五点下班。","I finish work at five."],["aider","v","帮助","to help","helfen","Je peux vous aider ?","我能帮您吗？","Can I help you?"],["chanter","v","唱歌","to sing","singen","Elle chante dans une chorale.","她在合唱团唱歌。","She sings in a choir."],["fatigué","adj","累的","tired","müde","Je suis fatigué après le voyage.","旅行后我很累。","I'm tired after the trip."],["content","adj","高兴的","happy; pleased","froh; zufrieden","Je suis content de te voir.","见到你很高兴。","I'm glad to see you."],["triste","adj","难过的","sad","traurig","Ce film est triste.","这部电影很悲伤。","This film is sad."],["facile","adj","容易的","easy","einfach","L'exercice est facile.","这个练习很简单。","The exercise is easy."],["difficile","adj","难的","difficult","schwierig","La grammaire est difficile.","语法很难。","The grammar is difficult."],["cher","adj","贵的；亲爱的","expensive; dear","teuer; lieb","Ce restaurant est trop cher.","这家餐厅太贵了。","This restaurant is too expensive."],["toujours","adv","总是；仍然","always; still","immer; noch","Il est toujours en retard.","他总是迟到。","He's always late."],["jamais","adv","从不","never","nie","Je ne bois jamais de café le soir.","我晚上从不喝咖啡。","I never drink coffee in the evening."],["parfois","adv","有时","sometimes","manchmal","Parfois, je travaille à la maison.","有时我在家工作。","Sometimes I work from home."],["déjà","adv","已经","already","schon","Tu as déjà mangé ?","你已经吃过了吗？","Have you already eaten?"],["ensuite","adv","然后","then; next","dann","D'abord on mange, ensuite on sort.","先吃饭，然后出门。","First we eat, then we go out."],["parce que","conj","因为","because","weil","Je reste ici parce qu'il pleut.","因为下雨我待在这里。","I'm staying here because it's raining."]]