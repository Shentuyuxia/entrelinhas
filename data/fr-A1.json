[["la maison","f","房子；家","house; home","das Haus","Ma maison est près de la gare.","我家在火车站附近。","My house is near the station."],["l'appartement","m","公寓","flat; apartment","die Wohnung","L'appartement a deux chambres.","这套公寓有两间卧室。","The flat has two bedrooms."],["la famille","f","家庭","family","die Familie","Je passe le week-end en famille.","我和家人一起过周末。","I spend the weekend with my family."],["l'ami","m","朋友","friend","der Freund","C'est mon meilleur ami.","他是我最好的朋友。","He's my best friend."],["le travail","m","工作","work; job","die Arbeit","Je vais au travail en vélo.","我骑自行车上班。","I cycle to work."],["l'école","f","学校","school","die Schule","Les enfants sont à l'école.","孩子们在学校。","The children are at school."],["le pain","m","面包","bread","das Brot","J'achète du pain à la boulangerie.","我在面包店买面包。","I buy bread at the bakery."],["l'eau","f","水","water","das Wasser","Un verre d'eau, s'il vous plaît.","请来一杯水。","A glass of water, please."],["le café","m","咖啡；咖啡馆","coffee; café","der Kaffee; das Café","On prend un café ?","我们去喝杯咖啡？","Shall we have a coffee?"],["le train","m","火车","train","der Zug","Le train part à huit heures.","火车八点出发。","The train leaves at eight."],["la ville","f","城市","town; city","die Stadt","Lyon est une belle ville.","里昂是座美丽的城市。","Lyon is a beautiful city."],["la rue","f","街道","street","die Straße","J'habite dans une petite rue.","我住在一条小街上。","I live on a small street."],["le jour","m","天；白天","day","der Tag","Il pleut tous les jours.","每天都下雨。","It rains every day."],["la semaine","f","星期","week","die Woche","Je travaille cinq jours par semaine.","我一周工作五天。","I work five days a week."],["l'année","f","年","year","das Jahr","Bonne année !","新年快乐！","Happy New Year!"],["le temps","m","时间；天气","time; weather","die Zeit; das Wetter","Quel temps fait-il ?","天气怎么样？","What's the weather like?"],["le livre","m","书","book","das Buch","Je lis un livre sur Paris.","我在读一本关于巴黎的书。","I'm reading a book about Paris."],["la musique","f","音乐","music","die Musik","J'écoute de la musique le soir.","我晚上听音乐。","I listen to music in the evening."],["être","v","是；在","to be","sein","Je suis fatiguée aujourd'hui.","我今天很累。","I'm tired today."],["avoir","v","有","to have","haben","J'ai deux sœurs.","我有两个姐妹。","I have two sisters."],["aller","v","去","to go","gehen; fahren","On va au cinéma ce soir.","我们今晚去看电影。","We're going to the cinema tonight."],["faire","v","做","to do; to make","machen","Qu'est-ce que tu fais demain ?","你明天做什么？","What are you doing tomorrow?"],["vouloir","v","想要","to want","wollen","Je voudrais un thé.","我想要一杯茶。","I'd like a tea."],["pouvoir","v","能","can; to be able to","können","Tu peux m'aider ?","你能帮我吗？","Can you help me?"],["manger","v","吃","to eat","essen","On mange à midi.","我们中午吃饭。","We eat at noon."],["parler","v","说","to speak","sprechen","Vous parlez anglais ?","您会说英语吗？","Do you speak English?"],["habiter","v","居住","to live","wohnen","J'habite à Hanovre.","我住在汉诺威。","I live in Hanover."],["aimer","v","喜欢；爱","to like; to love","mögen; lieben","J'aime beaucoup le jazz.","我很喜欢爵士乐。","I really like jazz."],["grand","adj","大的","big; tall","groß","C'est une grande maison.","这是一栋大房子。","It's a big house."],["petit","adj","小的","small; little","klein","J'ai un petit chien.","我有一只小狗。","I have a little dog."],["bon","adj","好的","good","gut","Ce gâteau est très bon.","这个蛋糕很好吃。","This cake is very good."],["nouveau","adj","新的","new","neu","J'ai un nouveau travail.","我有一份新工作。","I have a new job."],["beau","adj","美的","beautiful; fine","schön","Il fait beau aujourd'hui.","今天天气很好。","The weather is nice today."],["aujourd'hui","adv","今天","today","heute","Aujourd'hui, je reste à la maison.","今天我待在家里。","Today I'm staying home."],["demain","adv","明天","tomorrow","morgen","À demain !","明天见！","See you tomorrow!"],["ici","adv","这里","here","hier","Viens ici, s'il te plaît.","请过来。","Come here, please."],["très","adv","非常","very","sehr","Merci, c'est très gentil.","谢谢，你真好。","Thanks, that's very kind."],["merci","interj","谢谢","thank you","danke","Merci beaucoup !","非常感谢！","Thank you very much!"],["s'il vous plaît","expr","请（敬语）","please (formal)","bitte","Un croissant, s'il vous plaît.","请给我一个可颂。","A croissant, please."],["bonjour","interj","你好；早上好","hello; good morning","guten Tag","Bonjour, madame !","女士，您好！","Hello, madam!"]]